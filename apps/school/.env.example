# Postgres. In production this must be a POOLED connection string — Neon's
# `-pooler` host — because each serverless invocation opens its own connection
# and a direct URL exhausts the database the first morning every class takes
# attendance at once.
DATABASE_URL="postgresql://school:school@localhost:5432/school_dev?schema=public"

# Optional: connections per process. Keep it small on serverless.
DATABASE_POOL_MAX=5

# Name of the session cookie.
SESSION_COOKIE_NAME="sala_session"
